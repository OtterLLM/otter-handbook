---
import { parts, site } from '../site.config';
import { url } from '../lib/url';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const text = t(lang);
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <p class="footer-say">{text.site.tagline}<br />{text.footer.say}</p>
      <div>
        <h3 class="label">{text.footer.handbook}</h3>
        <ul>
          {Object.entries(parts).map(([key, p]) => <li><a href={url('/handbook/', lang)}>{p.no} · {text.parts[key].title}</a></li>)}
        </ul>
      </div>
      <div>
        <h3 class="label">{text.footer.onsite}</h3>
        <ul>
          {site.nav.map((item) => <li><a href={url(item.href, lang)}>{text.nav[item.key]}</a></li>)}
        </ul>
      </div>
      <div>
        <h3 class="label">{text.footer.project}</h3>
        <ul>
          <li><a href={site.repo} rel="noopener">GitHub ↗</a></li>
          <li><a href={url('/about/', lang)}>{text.footer.contribute}</a></li>
          <li><a href={url('/lab/', lang)}>{text.footer.lab}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-base label">
      <span>{site.name} {site.version} · © {site.author} · {text.site.license}</span>
      <span>{text.footer.fonts}</span>
      <span>{text.footer.cover}</span>
    </div>
  </div>
  <span class="footer-word dots" aria-hidden="true">{site.name}</span>
</footer>
