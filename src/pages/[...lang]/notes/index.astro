---
/** Notes: a running log in time order. */
import '../../../styles/home.css';
import '../../../styles/inner.css';
import Base from '../../../layouts/Base.astro';
import { contentLangAttr, fmtDate, getNotes, pad2 } from '../../../lib/handbook';
import { kinds } from '../../../site.config';
import { url } from '../../../lib/url';
import { getLang, langParams, t } from '../../../i18n';

export function getStaticPaths() {
  return langParams();
}

const lang = getLang(Astro.params.lang);
const text = t(lang);
const tx = text.notes;
const notes = await getNotes(lang);
---

<Base lang={lang} title={tx.title} description={tx.description}>
  <section class="ph">
    <div class="wrap">
      <p class="crumbs label"><span class="accent">§</span><span>{tx.crumb}</span></p>
      <div class="ph-title">
        <div>
          <h1>{tx.title}</h1>
          <p class="ph-en">{tx.sub}</p>
        </div>
      </div>
      <p class="ph-lead">{tx.lead}</p>
      <dl class="ph-meta">
        <div><dt class="label">{tx.total}</dt><dd>{pad2(notes.length)} {tx.unit}</dd></div>
        {
          (Object.entries(kinds) as [keyof typeof kinds, (typeof kinds)[keyof typeof kinds]][]).map(([key, k]) => (
            <div><dd><span class="kind" data-kind={key}>{k.mark} {text.kinds[key].label}</span></dd></div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="band">
    <div class="wrap pad">
      <ol class="notes">
        {
          notes.map((n) => (
            <li>
              <a class="note" href={url(`/notes/${n.id}/`, lang)}>
                <time datetime={fmtDate(n.data.date)}>{fmtDate(n.data.date)}</time>
                <span class="kind" data-kind={n.data.kind}>{kinds[n.data.kind].mark} {text.kinds[n.data.kind].label}</span>
                <div>
                  <h3>
                    <span lang={n.fallback ? contentLangAttr(n.contentLang) : undefined} style={`view-transition-name:note-${n.id}`}>{n.data.title}</span>
                    {n.data.sample && <span class="note-sample">{text.common.sample}</span>}
                    {n.data.draft && <span class="note-sample">{text.common.draft}</span>}
                    {n.fallback && <span class="note-sample">{text.common.fallbackTag}</span>}
                  </h3>
                  {n.data.summary && <p lang={n.fallback ? contentLangAttr(n.contentLang) : undefined}>{n.data.summary}</p>}
                </div>
                <span class="row-arr" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>
